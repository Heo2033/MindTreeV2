# Server configuration
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/mindtree.db

# LLM Configuration
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.odirouter.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-flash
LLM_MODEL_STRONG=claude-sonnet-5
LLM_MODEL_FAST=qwen3.6-flash
LLM_TEMPERATURE=0.7
LLM_SEED=42
LLM_NUM_CTX=32768
LLM_TIMEOUT_MS=180000

# Rate limits
LLM_MAX_RPM=10
LLM_MAX_RPD=500
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=3
