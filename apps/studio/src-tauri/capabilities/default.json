{
  "identifier": "com.mindtree.studio",
  "description": "MindTree Studio permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
