{
  "name": "mindtree-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server:mock": "tsx watch --env-file=.env.mock src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@mindtree/types": "*",
    "fastify": "^5.3.3",
    "@fastify/cors": "^11.0.1",
    "better-sqlite3": "^11.9.1",
    "zod": "^3.24.4",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0",
    "eslint": "^9.28.0",
    "typescript-eslint": "^8.33.0"
  }
}
