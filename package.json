{
  "name": "mindtree-v2",
  "private": true,
  "workspaces": [
    "packages/types",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:server:mock": "npm run dev:server:mock -w server",
    "build:types": "npm run build -w @mindtree/types",
    "build:server": "npm run build -w server",
    "build:all": "npm run build:types && npm run build:server",
    "typecheck": "npm run typecheck -w @mindtree/types && npm run typecheck -w mindtree-server",
    "lint": "eslint packages/types/src server/src",
    "test": "vitest run -c server/vitest.config.ts",
    "test:types": "vitest run",
    "test:watch": "vitest -c server/vitest.config.ts"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.0"
  }
}
